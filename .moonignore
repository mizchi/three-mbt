# .moonignore replaces .gitignore for packaging; retain build/dependency ignores.
/_build/
/target/
/.mooncakes/
/node_modules/
/test-results/
/playwright-report/

# Separate workspace modules are outside the published library.
# Use `just package` to package luna-three outside these inherited ignore rules.
/examples/
/luna-three/
/moon.work
