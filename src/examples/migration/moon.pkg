import {
  "mizchi/three",
  "moonbitlang/async/js_async",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "render_ubo",
        "render_copies",
        "render_effect",
        "plugin_roundtrip",
        "render_helpers",
        "load_formats",
        "texture_exports",
        "rig_clip",
        "decompress_texture",
      ],
      "format": "esm",
    },
  },
)
