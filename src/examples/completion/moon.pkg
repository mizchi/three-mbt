import {
  "mizchi/three",
  "moonbitlang/async/js_async",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "render_patch",
        "render_partial",
        "render_mipmaps",
        "load_3mf",
        "usdz_roundtrip",
        "export_draco",
      ],
      "format": "esm",
    },
  },
)
