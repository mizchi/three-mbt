///|
pub fn render_stencil() -> FixedArray[Int] {
  let renderer = @three.WebGLRenderer(antialias=false)
  defer {
    renderer.dispose()
    renderer.force_context_loss()
  }
  renderer.set_size(32, 32)
  let target = @three.WebGLRenderTarget(32, 32)
  target.set_stencil_buffer(true)
  defer target.dispose()
  let scene = @three.Scene()
  let camera = @three.PerspectiveCamera(60, 1, 0.1, 100)
  camera.as_object3d().position().set(0, 0, 3) |> ignore
  let mask_geometry = @three.PlaneGeometry(1, 1).as_buffer_geometry()
  let color_geometry = @three.PlaneGeometry(4, 4).as_buffer_geometry()
  defer mask_geometry.dispose()
  defer color_geometry.dispose()
  let mask_material = @three.MeshBasicMaterial(0xffffff).as_material()
  let color_material = @three.MeshBasicMaterial(0xff0000).as_material()
  defer mask_material.dispose()
  defer color_material.dispose()
  mask_material.set_color_write(false)
  mask_material.set_depth_write(false)
  mask_material.set_stencil_write(true)
  mask_material.set_stencil_func(Always)
  mask_material.set_stencil_ref(1)
  mask_material.set_stencil_zpass(Replace)
  color_material.set_stencil_write(true)
  color_material.set_stencil_func(Equal)
  color_material.set_stencil_ref(1)
  color_material.set_stencil_write_mask(0)
  let mask = @three.Mesh(mask_geometry, mask_material).as_object3d()
  let color = @three.Mesh(color_geometry, color_material).as_object3d()
  color.set_render_order(1)
  scene.as_object3d().add(mask).add(color) |> ignore
  renderer.set_render_target(Some(target))
  renderer.render(scene, camera.as_camera())
  let center = Bytes::new(4)
  let outside = Bytes::new(4)
  renderer.read_render_target_pixels(target, 16, 16, 1, 1, center)
  renderer.read_render_target_pixels(target, 4, 16, 1, 1, outside)
  scene.as_object3d().remove(mask) |> ignore
  color_material.set_stencil_write(false)
  renderer.set_local_clipping_enabled(true)
  color_material.set_clipping_planes([@three.Plane(@three.Vector3(1, 0, 0), 0)])
  color_material.mark_needs_update()
  renderer.render(scene, camera.as_camera())
  let left = Bytes::new(4)
  let right = Bytes::new(4)
  renderer.read_render_target_pixels(target, 4, 16, 1, 1, left)
  renderer.read_render_target_pixels(target, 28, 16, 1, 1, right)
  renderer.set_render_target(None)
  [center[0].to_int(), outside[0].to_int(), left[0].to_int(), right[0].to_int()]
}
