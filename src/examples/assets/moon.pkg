import {
  "mizchi/three",
  "moonbitlang/async/js_async",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "load_compressed",
        "reject_invalid_assets",
        "render_objects",
        "render_stencil",
        "sample_textures",
      ],
      "format": "esm",
    },
  },
)
