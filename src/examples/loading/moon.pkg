import {
  "mizchi/three",
  "moonbitlang/async/js_async",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "create_file_loader",
        "load_file_text",
        "load_file_bytes",
        "load_file_json",
        "abort_file",
        "load_geometry",
        "load_material",
        "load_animation",
        "parse_object",
        "render_object",
      ],
      "format": "esm",
    },
  },
)
