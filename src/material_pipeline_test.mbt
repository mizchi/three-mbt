///|
test "Material pipeline settings clone independently including clipping planes" {
  let material = @three.MeshBasicMaterial(0xffffff).as_material()
  material.set_blending(Custom)
  material.set_blend_src(SrcAlpha)
  material.set_blend_dst(OneMinusSrcAlpha)
  material.set_blend_equation(Add)
  material.set_blend_src_alpha(Some(One))
  material.set_stencil_write(true)
  material.set_stencil_func(Equal)
  material.set_stencil_ref(3)
  material.set_stencil_zpass(Replace)
  material.set_stencil_write_mask(15)
  material.set_color_write(false)
  material.set_clipping_planes([@three.Plane(@three.Vector3(1, 0, 0), 2)])
  material.set_clip_shadows(true)
  material.set_polygon_offset(true)
  material.set_polygon_offset_factor(1)
  let copy = material.clone()
  assert_eq(copy.blending(), Custom)
  assert_eq(copy.blend_src(), SrcAlpha)
  assert_eq(copy.blend_dst(), OneMinusSrcAlpha)
  assert_eq(copy.blend_src_alpha(), Some(One))
  assert_eq(copy.stencil_func(), Equal)
  assert_eq(copy.stencil_zpass(), Replace)
  assert_eq(copy.stencil_ref(), 3)
  assert_eq(copy.stencil_write_mask(), 15)
  assert_false(copy.color_write())
  copy.clipping_planes()[0].set_constant(4)
  assert_eq(material.clipping_planes()[0].constant(), 2)
  copy.set_blend_src_alpha(None)
  assert_true(copy.blend_src_alpha() is None)
  assert_true(copy.clip_shadows())
}

///|
test "Specialized materials and typed shadow cameras expose their parameters" {
  let toon = @three.MeshToonMaterial(0xff0000)
  let texture = @three.Texture()
  toon.set_gradient_map(Some(texture))
  assert_true(toon.gradient_map().unwrap().same_reference(texture))
  let matcap = @three.MeshMatcapMaterial(0xffffff)
  matcap.set_matcap(Some(texture))
  assert_true(matcap.matcap().unwrap().same_reference(texture))
  let depth = @three.MeshDepthMaterial()
  depth.set_depth_packing(RGBA)
  assert_eq(depth.depth_packing(), RGBA)
  let raw = @three.RawShaderMaterial("", "", @three.Uniforms())
  raw.as_shader_material().set_glsl_version(Some(GLSL3))
  assert_eq(raw.as_shader_material().glsl_version(), Some(GLSL3))
  let light = @three.DirectionalLight(0xffffff, 1)
  let camera = light.shadow().camera().as_orthographic_camera().unwrap()
  camera.set_near(0.5)
  camera.set_far(20)
  camera.update_projection_matrix()
  light.shadow().set_auto_update(false)
  light.shadow().mark_needs_update()
  assert_eq(camera.far(), 20)
  assert_true(light.shadow().needs_update())
}
