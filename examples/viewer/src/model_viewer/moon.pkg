import {
  "mizchi/three",
  "moonbitlang/async/js_async",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "load_model",
        "render_triangle",
        "load_texture",
        "render_model",
      ],
      "format": "esm",
    },
  },
)
