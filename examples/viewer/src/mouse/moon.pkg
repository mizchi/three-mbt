import {
  "mizchi/three",
  "mizchi/three-viewer/parts",
  "mizchi/three-viewer/rabbit",
  "mizchi/three-viewer/purple",
  "moonbitlang/async/js_async",
  "moonbitlang/core/math",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "create_mouse",
        "create_viewer",
        "select_model",
        "resize",
        "render",
        "reset_view",
        "navigate",
        "set_wireframe",
        "triangle_count",
        "export_mouse",
        "export_model",
        "dispose",
      ],
      "format": "esm",
    },
  },
)
